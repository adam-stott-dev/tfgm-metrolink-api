# Comma-separated API keys; add :N for a per-key requests-per-minute limit
API_KEYS=dev-key,partner-key:600
RATE_LIMIT_PER_MINUTE=60

# Upstash Redis for rate limiting (or KV_REST_API_URL / KV_REST_API_TOKEN from the Vercel integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nightly timetable refresh
CRON_SECRET=
DEPLOY_HOOK_URL=

# Optional overrides for the timetable source
# GTFS_URL=https://odata.tfgm.com/opendata/downloads/TfGMgtfsnew.zip
# GTFS_FILE=./gtfs.zip
